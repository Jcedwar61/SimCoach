            "Left": {
              "Formula": {
                "Expression": "if(isnull([SimCoach.Delta], 0) < 0, 320 - min(abs([SimCoach.Delta]), 2) / 2 * 280, 320)"
              },
              "Mode": 2
            },
            "BackgroundColor": {
              "Formula": {
                "Expression": "if(isnull([SimCoach.Delta], 0) > 0, '#FFF87171', '#FF34D399')"
