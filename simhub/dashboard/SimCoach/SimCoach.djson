          "Height": 40.0,
          "Left": 170.0,
          "Top": 460.0,
          "Visible": true,
          "BlinkPhasisInverted": false,
          "Width": 940.0,
          "Name": "TargetIdle",
          "Bindings": {
            "Text": {
              "Formula": {
                "JSExt": 0,
                "Interpreter": 1,
                "Expression": "const t = $prop('SimCoach.TargetLap'), b = $prop('SimCoach.BestLap');\nif (!t && !b) return '';\nreturn (b ? 'Best ' + b : '') + (b && t ? '    ' : '') + (t ? 'Target ' + t : '');"
              },
              "Mode": 2
            }
          }
        },
