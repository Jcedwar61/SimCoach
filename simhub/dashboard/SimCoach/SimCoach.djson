          "Height": 44.0,
          "Left": 170.0,
          "Top": 300.0,
          "Visible": true,
          "BlinkPhasisInverted": false,
          "Width": 940.0,
          "Name": "StatusHead",
          "Bindings": {
            "Text": {
              "Formula": {
                "JSExt": 0,
                "Interpreter": 1,
                "Expression": "if (!$prop('SimCoach.Connected')) return 'SimCoach is not running';\nif (!$prop('SimCoach.Running')) return 'SimCoach is open: press Start coaching';\nreturn $prop('SimCoach.Status') || 'Waiting for a sim…';"
              },
              "Mode": 2
            },
            "TextColor": {
              "Formula": {
                "Expression": "if([SimCoach.Connected], '#FF34D399', '#FFF87171')"
              },
              "Mode": 2
            }
          }
        },
        {
          "$type": "SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins",
          "IsTextItem": true,
          "Font": "Roboto",
          "TextWrapping": 2,
          "FontWeight": "Normal",
          "FontSize": 17.0,
          "Text": "",
          "TextColor": "#FF8D99A8",
          "HorizontalAlignment": 1,
          "VerticalAlignment": 1,
          "BackgroundColor": "#00FFFFFF",
          "Height": 40.0,
          "Left": 170.0,
          "Top": 350.0,
          "Visible": true,
          "BlinkPhasisInverted": false,
          "Width": 940.0,
          "Name": "StatusSub",
          "Bindings": {
            "Text": {
              "Formula": {
                "JSExt": 0,
                "Interpreter": 1,
                "Expression": "if (!$prop('SimCoach.Connected')) return 'Start SimCoach 6.22 or later. Its Settings tab: Send coaching to SimHub dashboards.';\nconst d = $prop('SimCoach.Driver');\nreturn 'SimCoach ' + $prop('SimCoach.Version') + (d ? '  ·  driver ' + d : '');"
              },
              "Mode": 2
            }
          }
        },
        {
          "$type": "SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins",
          "IsTextItem": true,
          "Font": "Roboto",
          "TextWrapping": 2,
          "FontWeight": "Normal",
          "FontSize": 19.0,
          "Text": "",
          "TextColor": "#FFFCD34D",
          "HorizontalAlignment": 1,
          "VerticalAlignment": 1,
          "BackgroundColor": "#00FFFFFF",
          "Height": 60.0,
          "Left": 170.0,
          "Top": 395.0,
          "Visible": true,
          "BlinkPhasisInverted": false,
          "Width": 940.0,
          "Name": "GoalIdle",
          "Bindings": {
            "Text": {
              "Formula": {
                "Expression": "isnull([SimCoach.Goal], '')"
              },
              "Mode": 2
            },
            "Visible": {
              "Formula": {
                "Expression": "[SimCoach.Connected]"
              },
              "Mode": 2
            }
          }
        },
        {
          "$type": "SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins",
